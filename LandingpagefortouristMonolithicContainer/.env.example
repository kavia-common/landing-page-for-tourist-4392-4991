# Environment variables for LandingpagefortouristMonolithicContainer
# Do NOT commit actual secrets. Provide values via orchestration.

# Port for Express server (defaults to 5000 if not set)
PORT=5000

# MongoDB connection string (optional). If not provided, inquiries won't be persisted.
# Example: mongodb+srv://user:password@cluster.example.mongodb.net/tourist?retryWrites=true&w=majority
MONGO_URI=
